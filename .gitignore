# Generated artefacts: kept on disk, not versioned. Only the few files that a
# current document cites stay tracked (DESIGN.md's north-star mock, its review
# verdict and the concept corrections), plus Impeccable's workflow checkpoint.
/output/
/reports/*
!/reports/ui-tabs-concepts/
/reports/ui-tabs-concepts/*
!/reports/ui-tabs-concepts/README.md
/.impeccable/*
!/.impeccable/mocks/
