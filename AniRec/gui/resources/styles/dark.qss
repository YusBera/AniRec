/* AniRec dark theme, generated from design tokens. Do not edit by hand. */
QWidget {
    background-color: #0B0B0F;
    color: #F2F0ED;
    font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 9.0pt;
}
QLabel { background: transparent; }
QWidget#contentArea { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B0B0F, stop:1 #101015); }
QToolTip {
    background: #1E1E26; color: #F2F0ED; border: 1px solid #3A3A44;
    border-radius: 6px; padding: 6px;
}

QFrame#sidebar {
    background: #101015;
    border-right: 1px solid #1C1C23;
}
QFrame#sidebar QPushButton { text-align: left; padding: 10px 13px; }
QLabel#sidebarTitle, QLabel#pageTitle {
    color: #FFFFFF; font-size: 14.4pt; font-weight: 700;
}
QLabel#pageDescription, QLabel#sidebarFooter { color: #9A968F; }
QFrame#connectionStatusBar { background: transparent; border: none; }
QLabel#activeProfileLabel {
    background: #16161C; color: #F2F0ED; border: 1px solid #26262E;
    border-radius: 11px; padding: 7px 11px; font-weight: 600;
}
QLabel#malConnectionLabel {
    background: #2B1518; color: #F09A96; border: 1px solid #5E2C31;
    border-radius: 9px; padding: 4px 10px; font-weight: 600;
}
QLabel#malConnectionLabel[connected="true"] {
    background: #14251C; color: #7BD5A6; border-color: #2A5240;
}

QPushButton {
    background: #1E1E26;
    border: 1px solid #3A3A44;
    border-radius: 9px;
    color: #F2F0ED;
    padding: 8px 12px;
    text-align: center;
    font-weight: 600;
}
QPushButton:hover { background: #16161C; border-color: #E0685A; }
QPushButton:pressed { background: #0F0F14; }
QPushButton:focus { border: 2px solid #E0685A; }
QPushButton:checked { background: #E0685A; border-color: #EC7A6C; color: #FFFFFF; }
QPushButton:disabled { background: #0F0F14; color: #55524D; border-color: #1C1C23; }
QPushButton[buttonRole="primary"] {
    background: #E0685A; border-color: #EC7A6C; color: #FFFFFF;
}
QPushButton[buttonRole="primary"]:hover { background: #EC7A6C; border-color: #EC7A6C; }
QPushButton[buttonRole="secondary"] { background: #16161C; border-color: #3A3A44; }
QPushButton[buttonRole="ghost"] { background: transparent; border-color: #26262E; color: #9A968F; }
QPushButton[buttonRole="link"] {
    background: transparent; border-color: transparent; color: #F0958A;
    padding: 4px 2px; text-align: left;
}
QPushButton[buttonRole="link"]:hover { color: #EC7A6C; background: transparent; }
QPushButton[buttonRole="danger"] { background: #2B1518; border-color: #5E2C31; color: #F09A96; }
QPushButton[feedback="liked"]:checked {
    background: #14251C; border-color: #2A5240; color: #7BD5A6;
}
QPushButton[feedback="disliked"]:checked {
    background: #2B1518; border-color: #5E2C31; color: #F09A96;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background: #0F0F14;
    color: #F2F0ED;
    border: 1px solid #26262E;
    border-radius: 8px;
    padding: 7px 9px;
    min-height: 22px;
    selection-background-color: #3A211E;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #3A3A44; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #E0685A; }
QLineEdit:read-only { background: #08080B; color: #9A968F; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background: #1E1E26; color: #F2F0ED; border: 1px solid #3A3A44;
    selection-background-color: #3A211E; padding: 4px;
}
QMenu {
    background: #1E1E26; color: #F2F0ED; border: 1px solid #26262E;
    border-radius: 9px; padding: 6px;
}
QMenu::item { padding: 8px 28px 8px 12px; border-radius: 6px; }
QMenu::item:selected { background: #E0685A; color: #FFFFFF; }
QCheckBox { spacing: 8px; color: #F2F0ED; }
QCheckBox::indicator {
    width: 17px; height: 17px; border: 1px solid #3A3A44; border-radius: 5px;
    background: #0F0F14;
}
QCheckBox::indicator:checked { background: #E0685A; border-color: #EC7A6C; }

QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #3A3A44; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #6B6862; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #3A3A44; border-radius: 5px; min-width: 30px; }

QProgressBar {
    background: #0F0F14; border: 1px solid #26262E; border-radius: 6px;
    color: #F2F0ED; min-height: 12px; text-align: center;
}
QProgressBar::chunk { background: #E0685A; border-radius: 5px; }
QDialog#operationProgressDialog {
    background: #16161C; border: 1px solid #26262E; border-radius: 20px;
}
QLabel#progressStepLabel { color: #FFFFFF; font-size: 10.3pt; font-weight: 700; }
QLabel#progressCounterLabel { color: #9A968F; font-weight: 600; }
QDialog#operationProgressDialog[operationState="success"] QLabel#progressStepLabel,
QDialog#operationProgressDialog[operationState="success"] QLabel#progressCounterLabel {
    color: #7BD5A6;
}

QDialog#errorDialog, QDialog#setupWizard { background: #0B0B0F; }
QLabel#wizardStepIndicator { color: #9A968F; font-weight: 700; }
QLabel#wizardRequiredHint, QLabel#wizardFieldHint { color: #9A968F; font-size: 8.3pt; }
QLabel#wizardIntro { color: #F2F0ED; font-size: 9.0pt; }
QLabel#wizardSteps { color: #9A968F; font-size: 8.3pt; }
QLabel#wizardApiLink { color: #F0958A; font-weight: 600; }
QLabel#apiTestStatus, QLabel#oauthStatusLabel, QLabel#analysisStatusLabel { color: #9A968F; }

QFrame#dashboardMetricCard, QFrame#dashboardPanel, QFrame[metricCard="true"] {
    background: #16161C; border: 1px solid #26262E; border-radius: 14px;
}
QLabel#dashboardMetricLabel, QLabel#dashboardActionReason { color: #9A968F; }
QLabel#dashboardMetricValue { color: #FFFFFF; font-size: 11.7pt; font-weight: 700; }
QLabel#dashboardSectionTitle { color: #FFFFFF; font-size: 10.3pt; font-weight: 700; }
QLabel#dashboardEmptyState {
    background: #2A2113; border: 1px solid #5C4A25; border-radius: 10px;
    color: #E5C27E; padding: 10px 12px;
}
QLabel#dashboardActivity {
    background: #1E1E26; border: 1px solid #26262E; border-radius: 10px;
    color: #9A968F; padding: 6px 11px; font-weight: 600;
}
QLabel#dashboardActivity[tone="success"] { background: #14251C; border-color: #2A5240; color: #7BD5A6; }
QLabel#dashboardActivity[tone="busy"] { background: #1E1E2E; border-color: #43436B; color: #B9B9E0; }
QLabel#dashboardActivity[tone="error"] { background: #2B1518; border-color: #5E2C31; color: #F09A96; }
QLabel#dashboardGenreName { color: #F2F0ED; font-weight: 600; }
QLabel#dashboardGenreScore { color: #F0958A; font-weight: 700; }
QProgressBar#dashboardGenreBar { min-height: 9px; max-height: 9px; border: none; background: #0F0F14; }
QFrame[homeRecommendationCard="true"] {
    background: #16161C; border: 1px solid #26262E; border-radius: 12px;
}
QFrame[homeRecommendationCard="true"]:hover { border-color: #E0685A; background: #1E1E26; }
QLabel#homeRecommendationCover { background: #08080B; border-radius: 8px; }
QLabel#homeRecommendationTitle { color: #FFFFFF; font-size: 8.3pt; font-weight: 700; }
QLabel#homeRecommendationScore { color: #F0958A; font-weight: 700; }
QLabel#homeRecommendationMeta, QLabel#dashboardNoRecommendations { color: #9A968F; }
QPushButton[dashboardAction="true"] { text-align: left; }

QFrame[recommendationCard="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1A1A21, stop:1 #131318);
    border: 1px solid #26262E; border-radius: 14px;
}
QFrame[recommendationCard="true"]:hover { background: #1E1E26; border-color: #E0685A; }
QFrame[recommendationCard="true"][tasteState="liked"] { border-color: #2A5240; }
QFrame[recommendationCard="true"][tasteState="disliked"] { border-color: #5E2C31; }
QFrame[recommendationCard="true"]:focus, QFrame[recommendationCard="true"][selected="true"] {
    border: 2px solid #E0685A;
}
QWidget#page-recommendations { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B0B0F, stop:1 #101015); }
QFrame#recommendationHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1B1A20, stop:0.55 #211B1D, stop:1 #2A1D1B);
    border: 1px solid #26262E; border-radius: 20px;
}
QLabel#recommendationEyebrow, QLabel#recommendationActionCaption {
    color: #E0685A; font-size: 7.4pt; font-weight: 800;
}
QLabel#recommendationHeroTitle { color: #FFFFFF; font-size: 21.2pt; font-weight: 800; }
QLabel#recommendationHeroDescription { color: #9A968F; font-size: 8.3pt; }
QFrame#recommendationControls, QTableWidget {
    background: #16161C; border: 1px solid #26262E; border-radius: 12px;
}
QFrame#recommendationControls { padding: 4px; }
QLabel#recommendationFeedbackSummary {
    background: #1E1E26; border: 1px solid #26262E; border-radius: 10px;
    color: #F2F0ED; padding: 8px 11px; font-weight: 600;
}
QFrame#recommendationLibraryBar {
    background: #0F0F14; border: 1px solid #26262E; border-radius: 15px;
}
QPushButton[libraryTab="true"] {
    background: transparent; border: 1px solid transparent; border-radius: 10px;
    color: #9A968F; padding: 9px 15px; font-weight: 700;
}
QPushButton[libraryTab="true"]:hover { background: #1E1E26; color: #FFFFFF; }
QPushButton[libraryTab="true"]:checked {
    background: #3A211E; border-color: #E0685A; color: #FFFFFF;
}
QPushButton[viewToggle="true"] { padding: 8px 11px; }
QFrame#recommendationSelectedActions {
    background: #16161C; border: 1px solid #26262E; border-radius: 12px;
}
QLabel#recommendationSelectedLabel { color: #F2F0ED; font-weight: 700; }
QLabel#recommendationFilterLabel, QLabel#recommendationResultCount { color: #9A968F; }
QFrame#recommendationEmptyPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1B1A20, stop:0.55 #211B1D, stop:1 #2A1D1B);
    border: 1px solid #26262E; border-radius: 20px;
}
QLabel#recommendationEmptyIcon {
    background: #E0685A; color: #FFFFFF; border: 1px solid #EC7A6C;
    border-radius: 28px; font-size: 17.6pt; font-weight: 800;
}
QLabel#recommendationEmptyTitle { color: #FFFFFF; font-size: 14.4pt; font-weight: 800; }
QLabel#recommendationEmptyState { color: #9A968F; font-size: 9.0pt; }
QLabel#personalMatchLabel { color: #F0958A; font-size: 10.3pt; font-weight: 700; }
QLabel#recommendationTitle { color: #FFFFFF; font-size: 9.0pt; font-weight: 700; }
QLabel#recommendationSecondaryTitle, QLabel#recommendationMeta { color: #9A968F; }
QLabel#recommendationGenres { color: #F2F0ED; }
QLabel#recommendationReason { color: #9A968F; }
QLabel#recommendationCover { background: #08080B; border-radius: 10px; }
QPushButton[savedAction="true"]:checked {
    background: #13202B; border-color: #2F5670; color: #91C4E0;
}
QFrame[recommendationRow="true"] {
    background: #16161C; border: 1px solid #26262E; border-radius: 12px;
}
QFrame[recommendationRow="true"]:hover { background: #1E1E26; border-color: #E0685A; }
QFrame[recommendationRow="true"][tasteState="liked"] { border-color: #2A5240; }
QFrame[recommendationRow="true"][tasteState="disliked"] { border-color: #5E2C31; }
QFrame[recommendationRow="true"]:focus,
QFrame[recommendationRow="true"][selected="true"] { border: 2px solid #E0685A; }
QLabel#recommendationRowCover { background: #08080B; border-radius: 8px; }
QLabel#recommendationRowTitle { color: #FFFFFF; font-size: 9.0pt; font-weight: 700; }
QLabel#recommendationRowReason { color: #9A968F; font-size: 8.3pt; }
QLabel#recommendationRowMatchTag {
    background: #3A211E; color: #F0958A; border: 1px solid #E0685A;
    border-radius: 9px; padding: 3px 9px; font-weight: 700;
}
QLabel#recommendationRowGenreTag {
    background: #0F0F14; color: #9A968F; border: 1px solid #26262E;
    border-radius: 9px; padding: 3px 9px;
}
QWidget#gradientPreview { border-radius: 10px; }
QHeaderView::section {
    background: #0F0F14; color: #9A968F; border: none;
    border-bottom: 1px solid #26262E; padding: 8px; font-weight: 600;
}
QTableWidget { gridline-color: #26262E; selection-background-color: #3A211E; }

QGroupBox[settingsCard="true"] {
    background: #16161C; border: 1px solid #26262E; border-radius: 14px;
    margin-top: 12px; padding: 18px 14px 14px 14px; font-weight: 700;
}
QGroupBox[settingsCard="true"]::title {
    subcontrol-origin: margin; left: 14px; padding: 0 7px; color: #FFFFFF;
}
QLabel#settingsStatus, QLabel#settingsApiStatus, QLabel#settingsDataScopeHint { color: #9A968F; }
QLabel#settingsStatus[error="true"] { color: #F09A96; }

QLabel#recommendationDetailTitle { color: #FFFFFF; font-size: 14.4pt; font-weight: 700; }
QLabel#recommendationDetailSecondaryTitle, QLabel#recommendationDetailAlternatives { color: #9A968F; }
QLabel#recommendationDetailSectionTitle { color: #FFFFFF; font-size: 9.0pt; font-weight: 700; }
QFrame#genreBarsFrame, QTableWidget#genreAnalysisTable, QFrame[advancedOperation="true"] {
    background: #16161C; border: 1px solid #26262E; border-radius: 12px;
}
QLabel#genreAnalysisEmptyState, QLabel#genreImportanceExactScore,
QLabel#advancedOperationDescription, QLabel#advancedOperationPrerequisite,
QLabel#advancedOperationLastRun { color: #9A968F; }
QLabel#advancedOperationTitle { color: #FFFFFF; font-size: 9.0pt; font-weight: 700; }
QLabel#errorDialogTitle { color: #FFFFFF; font-size: 11.7pt; font-weight: 700; }
QLabel#errorDialogDescription { color: #F2F0ED; }
QLabel#errorDialogSectionTitle { color: #FFFFFF; font-weight: 700; }
QPlainTextEdit#errorDialogTechnicalDetails {
    background: #08080B; border-color: #26262E; color: #9A968F;
}

