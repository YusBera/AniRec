/* AniRec light theme — Soft Indigo */
QWidget { background: #f3f5fb; color: #182038; font-family: "Segoe UI"; }
QLabel { background: transparent; }
QToolTip { background: #ffffff; color: #182038; border: 1px solid #cbd2e3; border-radius: 6px; padding: 6px; }
QFrame#sidebar { background: #ffffff; border-right: 1px solid #dce1ed; }
QFrame#sidebar QPushButton { text-align: left; padding: 10px 13px; }
QLabel#sidebarTitle, QLabel#pageTitle { color: #151d35; font-size: 24px; font-weight: 700; }
QLabel#pageDescription, QLabel#sidebarFooter { color: #66718a; }
QFrame#connectionStatusBar { background: #ffffff; border: 1px solid #dce1ed; border-radius: 12px; }
QLabel#activeProfileLabel { color: #3d4964; font-weight: 600; }
QLabel#malConnectionLabel { background: #fff0f3; color: #a63e58; border: 1px solid #efb6c2; border-radius: 9px; padding: 4px 10px; font-weight: 600; }
QLabel#malConnectionLabel[connected="true"] { background: #e8f8f1; color: #18704f; border-color: #a8dfca; }
QPushButton { background: #ffffff; border: 1px solid #cbd2e3; border-radius: 9px; color: #29344e; padding: 8px 12px; text-align: center; font-weight: 600; }
QPushButton:hover { background: #eef0ff; border-color: #8b84cf; }
QPushButton:pressed { background: #e4e7f8; }
QPushButton:focus { border: 2px solid #6759d6; }
QPushButton:checked { background: #6759d6; border-color: #6759d6; color: #ffffff; }
QPushButton:disabled { background: #eef0f5; color: #9aa2b4; border-color: #e0e4ec; }
QPushButton[buttonRole="primary"] { background: #6759d6; border-color: #6759d6; color: #ffffff; }
QPushButton[buttonRole="primary"]:hover { background: #7568e8; border-color: #7568e8; }
QPushButton[buttonRole="secondary"] { background: #ffffff; border-color: #bdc5d8; }
QPushButton[buttonRole="ghost"] { background: transparent; border-color: #d5dae6; color: #657088; }
QPushButton[buttonRole="link"] { background: transparent; border-color: transparent; color: #5c4fca; padding: 4px 2px; text-align: left; }
QPushButton[buttonRole="link"]:hover { color: #4438ae; background: transparent; }
QPushButton[buttonRole="danger"] { background: #fff0f3; border-color: #efb6c2; color: #a63e58; }
QPushButton[feedback="liked"]:checked { background: #def6eb; border-color: #7dc9aa; color: #166b4b; }
QPushButton[feedback="disliked"]:checked { background: #ffebef; border-color: #e69bad; color: #9d3851; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit { background: #ffffff; color: #182038; border: 1px solid #cbd2e3; border-radius: 8px; padding: 7px 9px; min-height: 22px; selection-background-color: #7568e8; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #9ba5bd; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #6759d6; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView { background: #ffffff; color: #182038; border: 1px solid #cbd2e3; selection-background-color: #7568e8; selection-color: #ffffff; padding: 4px; }
QCheckBox { spacing: 8px; color: #46516b; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid #aeb7ca; border-radius: 5px; background: #ffffff; }
QCheckBox::indicator:checked { background: #6759d6; border-color: #6759d6; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #c1c8d8; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #9ca6ba; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #c1c8d8; border-radius: 5px; min-width: 30px; }
QProgressBar { background: #e9ebf5; border: 1px solid #d4d9e6; border-radius: 6px; color: #182038; min-height: 12px; text-align: center; }
QProgressBar::chunk { background: #6759d6; border-radius: 5px; }
QFrame#dashboardMetricCard, QFrame#dashboardPanel { background: #ffffff; border: 1px solid #dce1ed; border-radius: 14px; }
QLabel#dashboardMetricLabel, QLabel#dashboardActionReason { color: #6d7890; }
QLabel#dashboardMetricValue { color: #151d35; font-size: 19px; font-weight: 700; }
QLabel#dashboardSectionTitle { color: #151d35; font-size: 17px; font-weight: 700; }
QLabel#dashboardEmptyState { background: #fff7dc; border: 1px solid #e8cf7a; border-radius: 10px; color: #644f0f; padding: 10px 12px; }
QLabel#dashboardActivity { background: #ffffff; border: 1px solid #d4d9e6; border-radius: 10px; color: #66718a; padding: 6px 11px; font-weight: 600; }
QLabel#dashboardActivity[tone="success"] { background: #e8f8f1; border-color: #a8dfca; color: #18704f; }
QLabel#dashboardActivity[tone="busy"] { background: #eeeaff; border-color: #c4bcf5; color: #5145b3; }
QLabel#dashboardActivity[tone="error"] { background: #fff0f3; border-color: #efb6c2; color: #a63e58; }
QLabel#dashboardGenreName { color: #46516b; font-weight: 600; }
QLabel#dashboardGenreScore { color: #5c4fca; font-weight: 700; }
QProgressBar#dashboardGenreBar { min-height: 9px; max-height: 9px; border: none; background: #e7e9f3; }
QFrame[homeRecommendationCard="true"] { background: #fafbff; border: 1px solid #d9deea; border-radius: 12px; }
QFrame[homeRecommendationCard="true"]:hover { border-color: #9f98d9; background: #f6f5ff; }
QLabel#homeRecommendationCover { background: #edf0f6; border-radius: 8px; }
QLabel#homeRecommendationTitle { color: #151d35; font-size: 14px; font-weight: 700; }
QLabel#homeRecommendationScore { color: #5c4fca; font-weight: 700; }
QLabel#homeRecommendationMeta, QLabel#dashboardNoRecommendations { color: #6d7890; }
QFrame[recommendationCard="true"] { background: #ffffff; border: 1px solid #d5dae7; border-radius: 14px; }
QFrame[recommendationCard="true"]:focus, QFrame[recommendationCard="true"][selected="true"] { border: 2px solid #6759d6; }
QFrame#recommendationControls, QTableWidget { background: #ffffff; border: 1px solid #dce1ed; border-radius: 12px; }
QFrame#recommendationControls { padding: 4px; }
QLabel#recommendationFeedbackSummary { background: #eeecff; border: 1px solid #cec8f7; border-radius: 10px; color: #5145b3; padding: 9px 12px; }
QLabel#recommendationFilterLabel, QLabel#recommendationResultCount { color: #66718a; }
QLabel#recommendationEmptyState { color: #66718a; font-size: 16px; }
QLabel#personalMatchLabel { color: #5c4fca; font-size: 17px; font-weight: 700; }
QLabel#recommendationTitle { color: #151d35; font-size: 16px; font-weight: 700; }
QLabel#recommendationSecondaryTitle, QLabel#recommendationMeta { color: #6d7890; }
QLabel#recommendationGenres { color: #46516b; }
QLabel#recommendationReason { color: #66718a; }
QLabel#recommendationCover { background: #edf0f6; border-radius: 10px; }
QHeaderView::section { background: #f0f2f8; color: #46516b; border: none; border-bottom: 1px solid #d8ddea; padding: 8px; font-weight: 600; }
QTableWidget { gridline-color: #e1e5ee; selection-background-color: #e4e0ff; selection-color: #242044; }
QGroupBox[settingsCard="true"] { background: #ffffff; border: 1px solid #dce1ed; border-radius: 14px; margin-top: 12px; padding: 18px 14px 14px 14px; font-weight: 700; }
QGroupBox[settingsCard="true"]::title { subcontrol-origin: margin; left: 14px; padding: 0 7px; color: #151d35; }
QLabel#settingsStatus, QLabel#settingsApiStatus, QLabel#settingsDataScopeHint { color: #66718a; }
QLabel#settingsStatus[error="true"] { color: #a63e58; }
QLabel#recommendationDetailTitle { color: #151d35; font-size: 23px; font-weight: 700; }
QLabel#recommendationDetailSecondaryTitle, QLabel#recommendationDetailAlternatives { color: #6d7890; }
QLabel#recommendationDetailSectionTitle { color: #151d35; font-size: 16px; font-weight: 700; }
QFrame#genreBarsFrame, QTableWidget#genreAnalysisTable, QFrame[advancedOperation="true"] { background: #ffffff; border: 1px solid #dce1ed; border-radius: 12px; }
QLabel#genreAnalysisEmptyState, QLabel#genreImportanceExactScore, QLabel#advancedOperationDescription, QLabel#advancedOperationPrerequisite, QLabel#advancedOperationLastRun { color: #66718a; }
QLabel#advancedOperationTitle { color: #151d35; font-size: 16px; font-weight: 700; }
QLabel#errorDialogTitle { color: #151d35; font-size: 20px; font-weight: 700; }
QLabel#errorDialogSectionTitle { color: #151d35; font-weight: 700; }
QPlainTextEdit#errorDialogTechnicalDetails { background: #f7f8fc; border-color: #d6dbe7; color: #29344e; }
QWidget#page-recommendations { background: #f5f6fb; }
QFrame#recommendationHero { background: #eeecff; border: 1px solid #c9c3f1; border-radius: 22px; }
QLabel#recommendationEyebrow, QLabel#recommendationActionCaption { color: #5c4fca; font-size: 11px; font-weight: 800; }
QLabel#recommendationHeroTitle { color: #151d35; font-size: 29px; font-weight: 800; }
QLabel#recommendationHeroDescription { color: #5f6a83; font-size: 14px; }
QFrame#recommendationLibraryBar { background: #ffffff; border: 1px solid #dce1ed; border-radius: 15px; }
QPushButton[libraryTab="true"] { background: transparent; border: 1px solid transparent; border-radius: 10px; color: #66718a; padding: 9px 15px; font-weight: 700; }
QPushButton[libraryTab="true"]:hover { background: #f0efff; color: #292343; }
QPushButton[libraryTab="true"]:checked { background: #e3dfff; border-color: #a9a0e5; color: #342b82; }
QPushButton[viewToggle="true"] { padding: 8px 11px; }
QFrame#recommendationSelectedActions { background: #ffffff; border: 1px solid #d7ddea; border-radius: 12px; }
QLabel#recommendationSelectedLabel { color: #46516b; font-weight: 700; }
QFrame#recommendationEmptyPanel { background: #ffffff; border: 1px solid #d8dced; border-radius: 22px; }
QLabel#recommendationEmptyIcon { background: #6759d6; color: #ffffff; border: 1px solid #5145b3; border-radius: 28px; font-size: 25px; font-weight: 800; }
QLabel#recommendationEmptyTitle { color: #151d35; font-size: 24px; font-weight: 800; }
QLabel#recommendationEmptyState { color: #66718a; font-size: 15px; }
QFrame[recommendationCard="true"]:hover { background: #f8f7ff; border-color: #9f98d9; }
QFrame[recommendationCard="true"][tasteState="liked"] { border-color: #7dc9aa; }
QFrame[recommendationCard="true"][tasteState="disliked"] { border-color: #e69bad; }
QPushButton[savedAction="true"]:checked { background: #e0f1ff; border-color: #8abfe3; color: #245f84; }
QDialog#operationProgressDialog[operationState="success"] QLabel#progressStepLabel,
QDialog#operationProgressDialog[operationState="success"] QLabel#progressCounterLabel { color: #18704f; }
